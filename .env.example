# Optional reference-only extraction. Leave blank for a fully offline numeric workflow.
# Set a Gemini model available to your own account; no key or model is bundled.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional local history folder; default outputs/runs. Do not publish this directory.
# COMMONROOT_OUTPUT_DIR=outputs/runs

# Public launch URLs, not secrets. Change these for hosting.
VITE_DASHBOARD_URL=http://localhost:8501
COMMONROOT_LANDING_URL=http://localhost:5173
